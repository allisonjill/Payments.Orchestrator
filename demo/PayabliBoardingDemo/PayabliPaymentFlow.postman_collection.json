{
	"info": {
		"_postman_id": "84d7a57-1934-4bc6-822e-dd10c057de04",
		"name": "Payabli Payment Flow",
		"description": "NOTE: Standard Payabli Authorize & Capture flow executed against your specific allocated Merchant ID (Paypoint).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authorize and Capture Transaction",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var response = pm.response.json();",
							"if (pm.response.code === 200 && (response.responseCode === \"00\" || response.responseCode === \"0\")) {",
							"    pm.collectionVariables.set(\"transactionId\", response.responseData.transactionId);",
							"    console.log(\"Transaction Successful! Transaction ID: \" + response.responseData.transactionId);",
							"} else {",
							"    console.error(\"Transaction Failed: \" + response.responseMessage);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "requestToken",
						"value": "{{PAYABLI_API_TOKEN}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"merchantId\": \"{{MERCHANT_ID}}\",\n  \"transactionType\": \"auth_capture\",\n  \"amount\": 10.50,\n  \"creditCard\": {\n    \"cardNumber\": \"{{TEST_CARD_NUMBER}}\",\n    \"expirationDate\": \"1225\",\n    \"cvv2\": \"123\"\n  },\n  \"billingAddress\": {\n    \"firstName\": \"John\",\n    \"lastName\": \"Smith\",\n    \"address1\": \"123 Main St\",\n    \"city\": \"Austin\",\n    \"state\": \"TX\",\n    \"zip\": \"73301\",\n    \"country\": \"USA\"\n  },\n  \"orderId\": \"PO-12345\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://api-sandbox.payabli.com/api/Transaction",
					"protocol": "https",
					"host": [
						"api-sandbox",
						"payabli",
						"com"
					],
					"path": [
						"api",
						"Transaction"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Void Transaction",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "requestToken",
						"value": "{{PAYABLI_API_TOKEN}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"merchantId\": \"{{MERCHANT_ID}}\",\n  \"transactionType\": \"void\",\n  \"transactionId\": \"{{transactionId}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://api-sandbox.payabli.com/api/Transaction",
					"protocol": "https",
					"host": [
						"api-sandbox",
						"payabli",
						"com"
					],
					"path": [
						"api",
						"Transaction"
					]
				}
			},
			"response": []
